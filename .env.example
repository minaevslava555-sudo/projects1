API_GPT=
TOKEN_TELEGRAM=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_URL=
# Preview / dry-run: skip order notify, webhook register/polling, inbound POST
# handling, and sendTelegramMessage. Preview + unknown VERCEL_ENV on Vercel are
# also denied for register/inbound/send even without this flag.
# Set to 1 on Preview when sharing a Production bot token is unavoidable.
# TELEGRAM_WEBHOOK_URL alone does NOT stop Preview from mutating webhooks.
TELEGRAM_NOTIFY_DISABLED=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ADMIN_LOGIN=
ADMIN_PASSWORD=

# Supabase (обязательно для сохранения заказов в projects1_orders)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Booking security (обязательно на Vercel Production/Preview)
# Cloudflare Turnstile — https://dash.cloudflare.com/ → Turnstile
# Local/dev без ключей использует тестовые always-pass ключи Cloudflare.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# HMAC secret for draft tokens (≥32 random bytes)
BOOKING_DRAFT_SECRET=
# Vercel Cron auth for /api/cron/cleanup-repair-photos
CRON_SECRET=

# Cleaning v1 (default off). See docs/CLEANING_V1_PRICING.md
# Client preview UI
NEXT_PUBLIC_CLEANING_V1_BOOKING_ENABLED=
# Client: allow Confirm submit (set together with server ORDERS flag)
NEXT_PUBLIC_CLEANING_V1_ORDERS_ENABLED=
# Server: accept cleaningPricingVersion v1 orders
CLEANING_V1_ORDERS_ENABLED=

# Massage & Wellness v1 (default off). Preview only until safety review.
# Client: new Massage & Wellness landing + wizard configure UI
NEXT_PUBLIC_MASSAGE_V1_UI_ENABLED=false
# Client: allow Confirm submit for massageVersion v1 (pair with server ORDERS)
NEXT_PUBLIC_MASSAGE_V1_ORDERS_ENABLED=false
# Server: accept massageVersion v1 order payloads
MASSAGE_V1_ORDERS_ENABLED=false
# Client: enable equipment checkboxes / Add in Learn more
NEXT_PUBLIC_MASSAGE_V1_EQUIPMENT_BOOKABLE=false
# Server: accept non-empty wellnessEquipmentIds
MASSAGE_V1_EQUIPMENT_BOOKABLE=false
# Client: allow selecting Premium Wellness in the UI estimate path
NEXT_PUBLIC_MASSAGE_V1_PREMIUM_WELLNESS_BOOKABLE=false
# Server: accept tariff premium-wellness-120
MASSAGE_V1_PREMIUM_WELLNESS_BOOKABLE=false
